.gitattributes text eol=lf
# 统一行尾与文本判定，避免 "LF will be replaced by CRLF" 警告与行尾漂移
* text=auto

# Windows 脚本(含中文，需 UTF-8 BOM + CRLF)
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 跨平台脚本与数据文件保持 LF
*.sh    text eol=lf
*.sql   text eol=lf
*.py    text eol=lf

# 二进制(不做行尾转换)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.mp3   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.xdb   binary
*.jar   binary
*.zip   binary
*.dump  binary
