## ======================= PostgreSQL =======================
#elseif ($dbType.name() == 'POSTGRE_SQL')
-- 菜单 SQL
-- PostgreSQL 提示：本项目库的 system_menu.id 是 bigint NOT NULL 且没有自增序列，
-- 不能像 MySQL 那样用 LAST_INSERT_ID()；这里用 DO 块显式分配 id（MAX(id) + 1），
-- 并通过变量把菜单 id 传给按钮 SQL。执行前请确认 id 段不与既有菜单冲突。
DO $$
DECLARE
    v_menu_id BIGINT;
BEGIN
    INSERT INTO system_menu(
        id, name, permission, type, sort, parent_id,
        path, icon, component, status, component_name
    )
    VALUES (
        COALESCE((SELECT MAX(id) FROM system_menu), 0) + 1,
        '${table.classComment}管理', '', 2, 0, ${table.parentMenuId},
        '${simpleClassName_strikeCase}', '', '${table.moduleName}/${table.businessName}/index', 0, '${table.className}'
    )
    RETURNING id INTO v_menu_id;

    -- 按钮 SQL
#foreach ($functionName in $functionNames)
#set ($index = $foreach.count - 1)
    INSERT INTO system_menu(
        id, name, permission, type, sort, parent_id,
        path, icon, component, status
    )
    VALUES (
        COALESCE((SELECT MAX(id) FROM system_menu), 0) + 1,
        '${table.classComment}${functionName}', '${permissionPrefix}:${functionOps.get($index)}', 3, $foreach.count, v_menu_id,
        '', '', '', 0
    );
#end
END $$;
