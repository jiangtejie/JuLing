<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxjl.juling.module.statistics.dal.mysql.member.MemberStatisticsMapper">

    <select id="selectSummaryListByAreaId"
            resultType="com.lxjl.juling.module.statistics.service.member.bo.MemberAreaStatisticsRespBO">
        SELECT area_id, COUNT(1) AS userCount
        FROM member_user
        WHERE deleted = 0
        GROUP BY area_id
    </select>

    <select id="selectSummaryListBySex"
            resultType="com.lxjl.juling.module.statistics.controller.admin.member.vo.MemberSexStatisticsRespVO">
        SELECT sex, COUNT(1) AS userCount
        FROM member_user
        WHERE deleted = 0
        GROUP BY sex
    </select>

    <select id="selectSummaryListByRegisterTerminal"
                         resultType="com.lxjl.juling.module.statistics.controller.admin.member.vo.MemberTerminalStatisticsRespVO">
        SELECT register_terminal as terminal, COUNT(1) AS userCount
        FROM member_user
        WHERE deleted = 0
        GROUP BY register_terminal
    </select>

    <select id="selectUserCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM member_user
        WHERE deleted = 0
        <if test="beginTime != null">
            AND create_time >= #{beginTime}
        </if>
        <if test="endTime != null">
            AND create_time &lt;= #{endTime}
        </if>
    </select>

    <select id="selectListByCreateTimeBetween"
            resultType="com.lxjl.juling.module.statistics.controller.admin.member.vo.MemberRegisterCountRespVO">
        <!-- 注意：必须返回真正的 date 类型，不能用 to_char。
             PostgreSQL 下 to_char 产出 TEXT，映射到 MemberRegisterCountRespVO.date（LocalDate）会报
             "Cannot convert the column of type TEXT to requested type java.time.LocalDate"。
             CAST(... AS DATE) 在 PostgreSQL / MySQL 下都可用。 -->
        SELECT CAST(create_time AS DATE) AS date,
               count(1)                  AS count
        FROM member_user
        WHERE create_time BETWEEN #{beginTime} AND #{endTime}
          AND deleted = 0
        GROUP BY CAST(create_time AS DATE)
    </select>

</mapper>


