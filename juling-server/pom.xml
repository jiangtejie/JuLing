<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.lxjl.boot</groupId>
        <artifactId>juling</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>juling-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        后端 Server 的主项目，通过引入需要 juling-module-xxx 的依赖，
        从而实现提供 RESTful API 给 juling-ui-admin、juling-ui-user 等前端项目。
        本质上来说，它就是个空壳（容器）！
    </description>
    <url>https://github.com/jiangtejie/JuLing</url>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：AI 模块的 BOM 不随依赖传递，这里在聚合域统一钉住版本，避免被第三方(如 tinyflow)拉低到 1.0.2 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.1.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- PostgreSQL 驱动：数据库为 PostgreSQL 时需要显式引入（juling-spring-boot-starter-mybatis 中为 optional） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- 会员中心 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-member</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-bpm</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 支付服务 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-pay</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 微信公众号模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-mp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 商城相关模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-product</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-promotion</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-trade</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-statistics</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- CRM 相关模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-crm</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ERP 相关模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-erp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- AI 大模型相关模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-ai</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- IoT 物联网相关模块(juling-module-iot 为聚合模块,实际引入 biz) -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-iot-biz</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- MES 制造执行系统相关模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-mes</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- WMS 仓库管理模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-wms</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- HRM 人力资源管理模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-hrm</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- FMS 财务管理模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-fms</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- PMS 项目管理模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-pms</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- IM 相关模块 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-module-im</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- spring boot 配置所需依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 服务保障相关 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-spring-boot-starter-protection</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal> <!-- 将引入的 jar 打入其中 -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
