{
  "name": "juling-mall-h5",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "炬信矩灵 · 订货商城 H5（Vue3 + Vite + TypeScript + Vant4）",
  "author": {
    "name": "炬信矩灵",
    "email": "dev@lxjl.local"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "pnpm run type-check && vite build",
    "build:test": "vite build --mode test",
    "build:prod": "vite build --mode production",
    "build:report": "vite build --mode report",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json,md}\"",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prepare": "node scripts/setup-husky.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vant": "^4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.6",
    "@unocss/reset": "^66.10.5",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.9.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.104.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,html,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  }
}
