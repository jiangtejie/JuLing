# ============================================================
# 通用环境变量（所有 mode 共享，可被 .env.[mode] 覆盖）
# 只有以 VITE_ 开头的变量才会被注入到客户端代码中
# ============================================================

# 应用标题（index.html 中通过 %VITE_APP_TITLE% 注入）
VITE_APP_TITLE=矩灵订货商城

# 多租户 ID（与后端 juling-server 的 tenant-id 请求头对应）
VITE_APP_TENANT_ID=1

# 本地存储 key 前缀，避免与同域其它应用冲突
VITE_STORAGE_PREFIX=juling-mall-h5-

# 后端接口前缀（yudao 体系 app 端约定为 /app-api）
VITE_API_PREFIX=/app-api

# WebSocket 前缀
VITE_WS_PATH=/infra/ws

# 上传方式：server 走服务端上传 | client 前端直传（S3）
VITE_UPLOAD_TYPE=server

# 是否开启 PWA（开发环境建议关闭，避免 Service Worker 缓存干扰调试）
VITE_PWA=true
