# ===== 开发环境 =====
# 接口地址留空 => axios 使用相对路径 /app-api，由下面的 Vite 代理转发，避免跨域
VITE_API_BASE_URL=
VITE_USE_PROXY=true
VITE_API_PROXY_TARGET=http://127.0.0.1:48080

# 注意：本机 3000 端口可能被 WSL(wslrelay) 占用，故默认使用 3001（与 juling-ui 其它子工程一致）
VITE_PORT=3001

VITE_DROP_CONSOLE=false
VITE_PWA=false

# 是否使用 src/mock 内置演示数据（后端未启动时也能完整预览页面）
# 接入真实后端后改为 false 即可
VITE_USE_MOCK=false
