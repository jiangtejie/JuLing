<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.lxjl.boot</groupId>
        <artifactId>juling</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>juling-module-bill</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        单据平台（Bill Platform）：单据类型注册、单号规则、状态机、单据关联（下推）、
        操作日志、扩展字段。各业务模块（ERP/商城/WMS…）通过 api 包调用，禁止各自实现一套。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-common</artifactId>
        </dependency>

        <!-- Lombok：新模块必须显式声明，否则注解处理器不生效（getter/builder 不会生成） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.lxjl.boot</groupId>
            <artifactId>juling-spring-boot-starter-mybatis</artifactId>
        </dependency>
    </dependencies>

</project>
