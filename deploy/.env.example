# 复制为 .env 后按实际填写。**不要提交 .env**
DB_NAME=yate
DB_USER=root
DB_PASSWORD=改成强密码
DB_PORT=5432
REDIS_PASSWORD=改成强密码
SERVER_PORT=48080
# 生产建议 2~4G；本地 Dockerfile 默认只给 512m，那是开发用的
JAVA_OPTS=-Xms2g -Xmx2g -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/juling-server/heap
HTTP_PORT=80
# 若新建了 application-prod.yaml 就改成 prod
SPRING_PROFILES_ACTIVE=local
